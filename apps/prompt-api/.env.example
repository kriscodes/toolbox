# Copy to .env for local development. On Render, enter secrets in Environment.
# Never prefix either secret with VITE_ or put it in frontend settings.
OPENAI_API_KEY=
# Use a random, private key with at least 24 characters. The browser asks for it.
PROMPT_BUILDER_ACCESS_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://toolbox.kristiansalmeron.com
PORT=3001

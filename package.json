{
  "name": "toolbox-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "tools/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @toolbox/web",
    "dev:api": "npm run dev --workspace @toolbox/prompt-api",
    "start:api": "npm run start --workspace @toolbox/prompt-api",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run check && npm run build --workspace @toolbox/web",
    "verify": "npm run lint && npm test && npm run build",
    "preview": "npm run preview --workspace @toolbox/web",
    "assets": "node scripts/prepare-assets.mjs"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "globals": "^17.14.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5"
  }
}
